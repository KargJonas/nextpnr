# clk is the 50 MHz on-chip oscillator: clock input W0 (datasheet Table 10).
set_clk clk W0
# The board LED (GPIO16, IOB (31,6)); count[24] also leaves on GPIO10 for the
# logic analyzer.
set_io led GPIO16
set_io la[0] GPIO8
set_io la[1] GPIO9
set_io la[2] GPIO10
# The oscillator's enable pad.
set_io clk_en 0 25
