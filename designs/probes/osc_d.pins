set_clk clk W0
# Pin rotation matches build/clock_debug/vendor_osc_probe_y26/io_spec_in.txt:
# q[0] is on GPIO10 (chip 31,25) so vendor and open place the FF at RBB_28_26.
set_io q[0] GPIO10
set_io q[1] GPIO9
set_io q[2] GPIO8
set_io q[3] GPIO11
set_io q[4] GPIO12
set_io q[5] GPIO13
set_io q[6] GPIO14
set_io q[7] GPIO15
set_io clk_en 0 25
set_io q_en[0] GPIO0
set_io q_en[1] GPIO1
set_io q_en[2] GPIO2
set_io q_en[3] GPIO3
set_io q_en[4] GPIO4
set_io q_en[5] GPIO5
set_io q_en[6] GPIO6
set_io q_en[7] GPIO7
